# Deployment credentials for scripts/deploy_godaddy.ps1
# Copy this file to ".env" and fill in real values, OR set these as
# environment variables in your shell before running the deploy script.
# NEVER commit the real .env file — it is gitignored.

# GoDaddy FTP username (defaults to file@akgularda.com if unset)
GODADDY_FTP_USER=file@akgularda.com

# GoDaddy FTP password — REQUIRED. Rotate this in your GoDaddy account
# if it was ever committed or shared in plaintext.
GODADDY_FTP_PASSWORD=your-ftp-password-here

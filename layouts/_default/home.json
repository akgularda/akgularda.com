{{- $items := slice -}}
{{- range first 50 (where .Site.RegularPages "Section" "in" (slice "blogs" "guides")).ByDate.Reverse -}}
  {{- $item := dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "content_text" (.Description | default .Summary | plainify | chomp)
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
  -}}
  {{- with .Params.tags }}{{- $item = merge $item (dict "tags" .) -}}{{- end -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $feed := dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" .Site.Title
  "home_page_url" .Site.Home.Permalink
  "feed_url" (printf "%sindex.json" .Site.Home.Permalink)
  "description" .Site.Params.description
  "authors" (slice (dict "name" .Site.Params.author "url" (printf "%sabout/" .Site.Home.Permalink)))
  "language" (.Site.LanguageCode | default "en-us")
  "items" $items
-}}
{{- $feed | jsonify (dict "indent" "  ") -}}
